<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SvalboardLayerViz.App.ViewModels"
             xmlns:views="using:SvalboardLayerViz.App.Views"
             x:Class="SvalboardLayerViz.App.Views.BoardView"
             x:DataType="vm:MainWindowViewModel">

    <Viewbox Stretch="Uniform" StretchDirection="Both" ClipToBounds="False">
        <Canvas Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}"
                Background="Transparent" ClipToBounds="False">

            <!-- Connect prompt centered in canvas -->
            <Panel Canvas.Left="0" Canvas.Top="0"
                   Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}"
                   IsVisible="{Binding !IsConnected}">
                <TextBlock Text="{Binding [Board_ConnectPrompt], Source={StaticResource Loc}}"
                           Foreground="#585B70"
                           FontSize="16"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Panel>

            <!-- Left hand — Border keeps MainWindowViewModel DataContext for positioning -->
            <Border Canvas.Left="{Binding LeftHandX}" Canvas.Top="{Binding LeftHandY}"
                    IsVisible="{Binding IsConnected}" ClipToBounds="False">
                <views:HandView DataContext="{Binding SelectedLayer.LeftHand}" ClipToBounds="False" />
            </Border>

            <!-- Right hand -->
            <Border Canvas.Left="{Binding RightHandX}" Canvas.Top="{Binding RightHandY}"
                    IsVisible="{Binding IsConnected}" ClipToBounds="False">
                <views:HandView DataContext="{Binding SelectedLayer.RightHand}" ClipToBounds="False" />
            </Border>

        </Canvas>
    </Viewbox>

</UserControl>
