<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SvalboardLayerViz.App.ViewModels"
        x:Class="SvalboardLayerViz.App.Views.ExportDialog"
        x:DataType="vm:ExportDialogViewModel"
        Title="Export Layers"
        Width="420" Height="580"
        MinWidth="350" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

    <DockPanel Margin="16">

        <!-- Footer buttons — always visible at bottom -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" />
            <Button Content="Export" Command="{Binding ExportCommand}" />
        </StackPanel>

        <!-- Format + page size — pinned at top -->
        <StackPanel DockPanel.Dock="Top" Spacing="12">
            <TextBlock Text="Format" FontSize="14" FontWeight="SemiBold" Foreground="#CDD6F4" />
            <ComboBox ItemsSource="{Binding AvailableFormats}"
                      SelectedItem="{Binding SelectedFormat}"
                      HorizontalAlignment="Stretch" />

            <!-- Page size (PDF only) -->
            <StackPanel Spacing="4" IsVisible="{Binding IsPdfSelected}">
                <TextBlock Text="Page Size" FontSize="12" Foreground="#A6ADC8" Margin="0,4,0,0" />
                <ComboBox ItemsSource="{Binding AvailablePageSizes}"
                          SelectedItem="{Binding SelectedPageSize}"
                          HorizontalAlignment="Stretch" />
            </StackPanel>

            <!-- Separator -->
            <Border Height="1" Background="#313244" Margin="0,4" />

            <!-- Layer selection header -->
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Layers" FontSize="14"
                           FontWeight="SemiBold" Foreground="#CDD6F4"
                           VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            HorizontalAlignment="Right" Spacing="8">
                    <Button Content="All" Command="{Binding SelectAllCommand}"
                            Padding="8,2" FontSize="11" />
                    <Button Content="None" Command="{Binding SelectNoneCommand}"
                            Padding="8,2" FontSize="11" />
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <!-- Layer list — fills remaining space, scrolls if needed -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
            <ItemsControl ItemsSource="{Binding LayerItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LayerExportItem">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,3">
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                      VerticalAlignment="Center" />
                            <Border Grid.Column="1" Width="10" Height="10" CornerRadius="5"
                                    Background="{Binding TabColor}" Margin="4,0,8,0"
                                    VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding DisplayName}"
                                       VerticalAlignment="Center" Foreground="#CDD6F4" />
                            <CheckBox Grid.Column="3" Content="Hide thumbs"
                                      IsChecked="{Binding HideThumbCluster}"
                                      FontSize="11" Foreground="#A6ADC8"
                                      VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>

</Window>
