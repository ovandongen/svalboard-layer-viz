<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SvalboardLayerViz.App.ViewModels"
        x:Class="SvalboardLayerViz.App.Views.HistoryWindow"
        x:DataType="vm:HistoryWindowViewModel"
        Title="{Binding [Title_History], Source={StaticResource Loc}}"
        Width="720" Height="520"
        MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="#1E1E2E">

    <DockPanel Margin="12">

        <!-- Footer: Import / Export-all / status / Close -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Left"
                    Content="{Binding [History_Import], Source={StaticResource Loc}}"
                    Command="{Binding ImportCommand}"
                    Padding="12,4" Margin="0,0,8,0" />
            <Button DockPanel.Dock="Left"
                    Content="{Binding [History_ExportAll], Source={StaticResource Loc}}"
                    Command="{Binding ExportAllCommand}"
                    Padding="12,4" Margin="0,0,8,0" />
            <Button DockPanel.Dock="Right"
                    Content="{Binding [Common_Close], Source={StaticResource Loc}}"
                    Command="{Binding CloseCommand}"
                    Padding="16,4" />
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#A6ADC8"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="4,0" />
        </DockPanel>

        <!-- Header -->
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding [Title_History], Source={StaticResource Loc}}"
                   FontSize="16" FontWeight="SemiBold"
                   Foreground="#CDD6F4"
                   Margin="0,0,0,8" />

        <!-- Search + filter chips -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <TextBox Grid.Column="0"
                     Text="{Binding SearchText}"
                     Watermark="{Binding [History_Search], Source={StaticResource Loc}}"
                     Margin="0,0,8,0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <ToggleButton Content="{Binding [History_Filter_Manual], Source={StaticResource Loc}}"
                              IsChecked="{Binding ShowManual}"
                              Padding="10,4" />
                <ToggleButton Content="{Binding [History_Filter_Auto], Source={StaticResource Loc}}"
                              IsChecked="{Binding ShowAuto}"
                              Padding="10,4" />
                <ToggleButton Content="{Binding [History_Filter_Initial], Source={StaticResource Loc}}"
                              IsChecked="{Binding ShowInitial}"
                              Padding="10,4" />
            </StackPanel>
        </Grid>

        <!-- Snapshot list -->
        <Border Background="#181825" CornerRadius="4">
            <ListBox x:Name="RowsList"
                     ItemsSource="{Binding Rows}"
                     SelectedItem="{Binding SelectedRow}"
                     Background="Transparent"
                     BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SnapshotRowViewModel">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="4,2">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding ReasonIcon}"
                                       Foreground="#89B4FA"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Width="20"
                                       TextAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding FormattedTimestamp}"
                                       Foreground="#A6ADC8"
                                       FontFamily="Consolas,Menlo,monospace"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="6,0,12,0" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding DisplayLabel}"
                                       Foreground="#CDD6F4"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                                <Button Content="{Binding [History_ViewDiff], Source={StaticResource Loc}}"
                                        Command="{Binding #RowsList.DataContext.OpenDiffCommand}"
                                        CommandParameter="{Binding}"
                                        Padding="6,2" FontSize="11"
                                        Background="#89B4FA" Foreground="#1E1E2E" FontWeight="SemiBold" />
                                <Button Content="{Binding [History_ExportRow], Source={StaticResource Loc}}"
                                        Command="{Binding #RowsList.DataContext.ExportCommand}"
                                        CommandParameter="{Binding}"
                                        Padding="6,2" FontSize="11" />
                                <Button Content="{Binding [History_DeleteRow], Source={StaticResource Loc}}"
                                        Command="{Binding #RowsList.DataContext.DeleteCommand}"
                                        CommandParameter="{Binding}"
                                        Padding="6,2" FontSize="11" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

    </DockPanel>

</Window>
