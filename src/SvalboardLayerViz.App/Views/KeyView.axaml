<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SvalboardLayerViz.App.ViewModels"
             x:Class="SvalboardLayerViz.App.Views.KeyView"
             x:DataType="vm:KeyViewModel"
             Width="{Binding Width}"
             Height="{Binding Height}"
             Background="Transparent">

    <!--
    Single key visual representation.

    Design goals:
    - Rounded rectangle background with layer-based color
    - Primary label centered
    - Secondary label (modifier) shown smaller above
    - Dimmed/dashed border for transparent keys
    - Tooltip on hover with full details
    -->

    <ToolTip.Tip>
        <TextBlock Text="{Binding Tooltip}" />
    </ToolTip.Tip>

    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem Header="{Binding [Key_EditKeycode], Source={StaticResource Loc}}"
                      Command="{Binding ClickCommand}"
                      IsVisible="{Binding IsEditMode}" />
            <MenuItem Header="{Binding [Key_SetCustomLabel], Source={StaticResource Loc}}"
                      Command="{Binding SetLabelCommand}"
                      IsVisible="{Binding !IsEditMode}" />
        </ContextMenu>
    </UserControl.ContextMenu>

    <Border CornerRadius="6"
            BorderThickness="{Binding ActiveBorderThickness}"
            Padding="2"
            Margin="1"
            Tapped="OnKeyTapped"
            Background="{Binding BackgroundColor}"
            BorderBrush="{Binding BorderColor}"
            Opacity="{Binding KeyOpacity}">

        <Grid Background="Transparent">
            <!-- Centered primary + secondary labels -->
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="0">

                <!-- Secondary label (modifier prefix) -->
                <TextBlock Text="{Binding SecondaryLabel}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{Binding TextColor}"
                           Opacity="0.8"
                           HorizontalAlignment="Center"
                           IsVisible="{Binding SecondaryLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="2" Opacity="0.4"
                                          OffsetX="0" OffsetY="0" />
                    </TextBlock.Effect>
                </TextBlock>

                <!-- Primary key label -->
                <TextBlock Text="{Binding DisplayLabel}"
                           FontSize="16"
                           FontWeight="ExtraBold"
                           Foreground="{Binding TextColor}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="2" Opacity="0.4"
                                          OffsetX="0" OffsetY="0" />
                    </TextBlock.Effect>
                </TextBlock>
            </StackPanel>

            <!-- Shifted symbol superscript (top-right corner) -->
            <TextBlock Text="{Binding ShiftedLabel}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{Binding TextColor}"
                       Opacity="0.7"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Margin="0,1,4,0"
                       IsVisible="{Binding ShiftedLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="2" Opacity="0.4"
                                      OffsetX="0" OffsetY="0" />
                </TextBlock.Effect>
            </TextBlock>
        </Grid>
    </Border>

</UserControl>
