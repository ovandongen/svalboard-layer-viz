<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SvalboardLayerViz.App.ViewModels"
             x:Class="SvalboardLayerViz.App.Views.KeyView"
             x:DataType="vm:KeyViewModel"
             Width="{Binding Width}"
             Height="{Binding Height}">

    <!--
    Single key visual representation.

    Design goals:
    - Rounded rectangle background with layer-based color
    - Primary label centered
    - Secondary label (modifier) shown smaller above
    - Dimmed/dashed border for transparent keys
    - Tooltip on hover with full details
    -->

    <ToolTip.Tip>
        <TextBlock Text="{Binding Tooltip}" />
    </ToolTip.Tip>

    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Set Custom Label..." Command="{Binding SetLabelCommand}" />
        </ContextMenu>
    </UserControl.ContextMenu>

    <Border CornerRadius="6"
            BorderThickness="1.5"
            Padding="2"
            Margin="1"
            Background="{Binding BackgroundColor}"
            BorderBrush="{Binding BorderColor}"
            Opacity="{Binding KeyOpacity}">

        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="0">

            <!-- Secondary label (modifier prefix) -->
            <TextBlock Text="{Binding SecondaryLabel}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{Binding TextColor}"
                       Opacity="0.8"
                       HorizontalAlignment="Center"
                       IsVisible="{Binding SecondaryLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="2" Opacity="0.4"
                                      OffsetX="0" OffsetY="0" />
                </TextBlock.Effect>
            </TextBlock>

            <!-- Primary key label -->
            <TextBlock Text="{Binding DisplayLabel}"
                       FontSize="16"
                       FontWeight="ExtraBold"
                       Foreground="{Binding TextColor}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="2" Opacity="0.4"
                                      OffsetX="0" OffsetY="0" />
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>
    </Border>

</UserControl>
