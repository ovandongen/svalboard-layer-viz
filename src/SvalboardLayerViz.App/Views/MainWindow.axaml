<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SvalboardLayerViz.App.ViewModels"
        xmlns:views="using:SvalboardLayerViz.App.Views"
        xmlns:conv="using:SvalboardLayerViz.App.Converters"
        x:Class="SvalboardLayerViz.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="MainWin"
        Title="Svalboard Layer Viz"
        Width="1200" Height="600"
        MinWidth="600" MinHeight="300"
        WindowStartupLocation="CenterScreen"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        SystemDecorations="Full"
        Topmost="{Binding IsAlwaysOnTop}">

    <Window.Resources>
        <conv:HexColorToBrushConverter x:Key="HexToBrush" />
    </Window.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Bars panel: Row 0 (top) or Row 2 (bottom), switched automatically.
             Inner Grid swaps StatusBar/LayerTabs so the status bar is always at the outer edge. -->
        <Grid x:Name="BarsPanel" Grid.Row="0" RowDefinitions="Auto,Auto">
            <!-- Status bar (solid, also serves as drag handle) -->
            <Border x:Name="StatusBar" Grid.Row="0" Background="#1E1E2E" Padding="12,8"
                    CornerRadius="8,8,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Left"
                            Command="{Binding QuitCommand}"
                            ToolTip.Tip="Quit"
                            Focusable="False"
                            Padding="6,4" Margin="0,0,8,0"
                            VerticalAlignment="Center">
                        <PathIcon Width="12" Height="12"
                                  Data="M18.3 5.71a1 1 0 0 0-1.41 0L12 10.59 7.11 5.7A1 1 0 0 0 5.7 7.11L10.59 12 5.7 16.89a1 1 0 1 0 1.41 1.41L12 13.41l4.89 4.89a1 1 0 0 0 1.41-1.41L13.41 12l4.89-4.89a1 1 0 0 0 0-1.4z" />
                    </Button>
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding StatusMessage}"
                               Foreground="#CDD6F4"
                               VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                HorizontalAlignment="Right" Spacing="4">
                        <StackPanel.Styles>
                            <Style Selector="StackPanel > Button">
                                <Setter Property="Focusable" Value="False" />
                            </Style>
                        </StackPanel.Styles>
                        <Button x:Name="LiveButton"
                                Command="{Binding ToggleLiveHighlightingCommand}"
                                ToolTip.Tip="Live key highlighting"
                                Padding="8,4"
                                IsVisible="{Binding IsConnected}">
                            <Button.Styles>
                                <Style Selector="Button#LiveButton">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Style>
                                <Style Selector="Button#LiveButton[Tag=True]">
                                    <Setter Property="Opacity" Value="1.0" />
                                </Style>
                            </Button.Styles>
                            <Button.Tag>
                                <Binding Path="IsLiveHighlightingEnabled" />
                            </Button.Tag>
                            <PathIcon Width="16" Height="16"
                                      Data="M3 12h4l3-8 4 16 3-8h4" />
                        </Button>
                        <Button x:Name="AutoLayerButton"
                                Command="{Binding ToggleAutoLayerSwitchCommand}"
                                ToolTip.Tip="Auto-switch layer (follows held layer keys)"
                                Padding="8,4"
                                IsVisible="{Binding IsLiveHighlightingEnabled}">
                            <Button.Styles>
                                <Style Selector="Button#AutoLayerButton">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Style>
                                <Style Selector="Button#AutoLayerButton[Tag=True]">
                                    <Setter Property="Opacity" Value="1.0" />
                                </Style>
                            </Button.Styles>
                            <Button.Tag>
                                <Binding Path="IsAutoLayerSwitchEnabled" />
                            </Button.Tag>
                            <PathIcon Width="14" Height="14"
                                      Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" />
                        </Button>
                        <Button Command="{Binding ResetLayerStateCommand}"
                                ToolTip.Tip="Reset layer tracking (back to base)"
                                Padding="8,4"
                                IsVisible="{Binding IsAutoLayerSwitchEnabled}">
                            <PathIcon Width="14" Height="14"
                                      Data="M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z" />
                        </Button>
                        <Button Command="{Binding OpenDiagnosticsCommand}"
                                ToolTip.Tip="Matrix diagnostics"
                                Padding="8,4"
                                IsVisible="{Binding IsLiveHighlightingEnabled}">
                            <PathIcon Width="14" Height="14"
                                      Data="M2 4a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V4zm5.5 4.5L10 11l-2.5 2.5L9 15l4-4-4-4-1.5 1.5zM13 15h4v-2h-4v2z" />
                        </Button>
                        <Button x:Name="PinButton"
                                Command="{Binding TogglePinCommand}"
                                ToolTip.Tip="Always on top"
                                Padding="8,4">
                            <Button.Styles>
                                <Style Selector="Button#PinButton">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Style>
                                <Style Selector="Button#PinButton[Tag=True]">
                                    <Setter Property="Opacity" Value="1.0" />
                                </Style>
                            </Button.Styles>
                            <Button.Tag>
                                <Binding Path="IsAlwaysOnTop" />
                            </Button.Tag>
                            <PathIcon Width="16" Height="16"
                                      Data="M16 12V4h1V2H7v2h1v8l-2 2v2h5.2v6h1.6v-6H18v-2z" />
                        </Button>
                        <Button Command="{Binding OpenSettingsCommand}"
                                ToolTip.Tip="Settings" Padding="8,4">
                            <PathIcon Width="16" Height="16"
                                      Data="M12.012 2.25c.734.008 1.465.093 2.182.253a.75.75 0 0 1 .582.649l.17 1.527a1.384 1.384 0 0 0 1.927 1.116l1.401-.615a.75.75 0 0 1 .85.174 9.792 9.792 0 0 1 2.204 3.792.75.75 0 0 1-.271.825l-1.242.916a1.381 1.381 0 0 0 0 2.226l1.243.915a.75.75 0 0 1 .272.826 9.797 9.797 0 0 1-2.21 3.79.75.75 0 0 1-.848.175l-1.407-.617a1.38 1.38 0 0 0-1.926 1.114l-.169 1.526a.75.75 0 0 1-.572.647 9.518 9.518 0 0 1-4.406 0 .75.75 0 0 1-.572-.647l-.168-1.524a1.382 1.382 0 0 0-1.926-1.11l-1.406.616a.75.75 0 0 1-.849-.175 9.798 9.798 0 0 1-2.21-3.796.75.75 0 0 1 .271-.826l1.244-.916a1.38 1.38 0 0 0 0-2.226l-1.243-.914a.75.75 0 0 1-.272-.826 9.793 9.793 0 0 1 2.21-3.792.75.75 0 0 1 .849-.174l1.4.615a1.387 1.387 0 0 0 1.93-1.118l.17-1.526a.75.75 0 0 1 .583-.65c.717-.159 1.45-.243 2.201-.252zM12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z" />
                        </Button>
                        <Button Command="{Binding RefreshCommand}"
                                ToolTip.Tip="Refresh" Padding="8,4">
                            <PathIcon Width="16" Height="16"
                                      Data="M18.537 19.567A9.961 9.961 0 0 1 12 22C6.477 22 2 17.523 2 12S6.477 2 12 2s10 4.477 10 10c0 2.136-.67 4.116-1.81 5.74L17 12h3a8 8 0 1 0-2.46 5.77z" />
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Layer tabs — background controlled by slider -->
            <Border x:Name="LayerTabs" Grid.Row="1"
                    Background="{Binding TabBackground, Converter={StaticResource HexToBrush}}"
                    Padding="8,4">
                <ItemsControl ItemsSource="{Binding Layers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LayerViewModel">
                            <Button Command="{Binding SelectCommand}"
                                    MinWidth="80"
                                    HorizontalContentAlignment="Center"
                                    Padding="12,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="10" Height="10" CornerRadius="5"
                                            Background="{Binding TabColor}" />
                                    <TextBlock Text="{Binding DisplayName}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>

        <!-- Board visualization area — background controlled by slider -->
        <Border Grid.Row="1" Padding="16"
                Background="{Binding BoardBackground, Converter={StaticResource HexToBrush}}">
            <views:BoardView DataContext="{Binding}" />
        </Border>

    </Grid>

</Window>
