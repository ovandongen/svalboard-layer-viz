<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SvalboardLayerViz.App.ViewModels"
        xmlns:conv="using:SvalboardLayerViz.App.Converters"
        x:Class="SvalboardLayerViz.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="{Binding [Title_Settings], Source={StaticResource Loc}}"
        Width="620" Height="700"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <conv:HexColorToBrushConverter x:Key="HexToBrush" />
    </Window.Resources>

    <DockPanel Margin="12">
        <!-- Footer buttons — always visible -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Content="{Binding [Common_Cancel], Source={StaticResource Loc}}" Command="{Binding CancelCommand}" />
            <Button Content="{Binding [Common_Save], Source={StaticResource Loc}}" Command="{Binding SaveCommand}" />
        </StackPanel>

        <!-- Version & update check -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0" Spacing="8">
            <TextBlock Text="{Binding AppVersion}" Foreground="#6C7086" FontSize="11"
                       VerticalAlignment="Center" />
            <Button Content="{Binding [Settings_CheckForUpdates], Source={StaticResource Loc}}"
                    Command="{Binding CheckForUpdatesCommand}"
                    IsVisible="{Binding !IsCheckingForUpdates}"
                    Padding="4,1" FontSize="11" Background="Transparent"
                    Foreground="#89B4FA" BorderThickness="0" Cursor="Hand" />
            <TextBlock Text="{Binding [Settings_Checking], Source={StaticResource Loc}}"
                       IsVisible="{Binding IsCheckingForUpdates}"
                       Foreground="#6C7086" FontSize="11" FontStyle="Italic"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding UpdateMessage}" Foreground="#A6E3A1" FontSize="11"
                       VerticalAlignment="Center"
                       IsVisible="{Binding UpdateMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Cursor="Hand" TextDecorations="Underline"
                       Name="UpdateLink" PointerPressed="OnUpdateLinkClick" />
        </StackPanel>

        <!-- Separator above version/buttons footer -->
        <Border DockPanel.Dock="Bottom" Height="1" Background="#45475A" Margin="0,10,0,0" />

        <TabControl>

            <!-- ══════════════ Appearance Tab ══════════════ -->
            <TabItem Header="{Binding [Settings_TabAppearance], Source={StaticResource Loc}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8,12" Spacing="12">

                    <!-- Layer Colors & Names -->
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding [Settings_LayerColorsAndNames], Source={StaticResource Loc}}"
                                   FontSize="14" FontWeight="SemiBold" Foreground="#CDD6F4"
                                   VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Content="{Binding [Settings_ResetColors], Source={StaticResource Loc}}"
                                Command="{Binding ResetColorsCommand}"
                                HorizontalAlignment="Right" Padding="8,3" FontSize="12" />
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding LayerSettings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LayerSettingViewModel">
                                <Grid ColumnDefinitions="56,*,Auto" Margin="0,2">
                                    <TextBlock Grid.Column="0" Text="{Binding LocalizedLayerLabel}"
                                               VerticalAlignment="Center" Foreground="#A6ADC8" FontSize="12" />
                                    <TextBox Grid.Column="1" Text="{Binding Name}"
                                             Watermark="{Binding [Settings_NameWatermark], Source={StaticResource Loc}}" Margin="6,0"
                                             VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Padding="2"
                                            Background="Transparent" BorderThickness="0"
                                            VerticalAlignment="Center">
                                        <Border Width="28" Height="20" CornerRadius="3"
                                                Background="{Binding EffectiveColor, Converter={StaticResource HexToBrush}}"
                                                BorderBrush="#45475A" BorderThickness="1" />
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedRight">
                                                <ColorView Color="{Binding PickerColor}"
                                                           IsAlphaVisible="False" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Separator -->
                    <Border Height="1" Background="#313244" Margin="0,4" />

                    <!-- Background Fill -->
                    <TextBlock Text="{Binding [Settings_BackgroundFill], Source={StaticResource Loc}}" FontSize="14" FontWeight="SemiBold"
                               Foreground="#CDD6F4" />
                    <TextBlock Text="{Binding [Settings_BackgroundFillHint], Source={StaticResource Loc}}"
                               Foreground="#6C7086" FontSize="11" Margin="0,-4,0,0" />
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding OpacityPercent}"
                                   Foreground="#CDD6F4" FontWeight="SemiBold" Width="40"
                                   VerticalAlignment="Center" TextAlignment="Right" />
                        <Slider Minimum="0" Maximum="1.0"
                                Value="{Binding BackgroundOpacity}"
                                TickFrequency="0.05" IsSnapToTickEnabled="True" />
                    </DockPanel>

                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════════ Behavior Tab ══════════════ -->
            <TabItem Header="{Binding [Settings_TabBehavior], Source={StaticResource Loc}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8,12" Spacing="12">

                    <!-- Language -->
                    <TextBlock Text="{Binding [Settings_Language], Source={StaticResource Loc}}"
                               FontSize="14" FontWeight="SemiBold" Foreground="#CDD6F4" />
                    <ComboBox ItemsSource="{Binding AvailableLanguages}"
                              SelectedItem="{Binding SelectedLanguage}"
                              HorizontalAlignment="Stretch" />

                    <!-- Separator -->
                    <Border Height="1" Background="#313244" Margin="0,4" />

                    <!-- Global Hotkey (not supported on Linux/Wayland) -->
                    <TextBlock Text="{Binding [Settings_GlobalHotkey], Source={StaticResource Loc}}" FontSize="14" FontWeight="SemiBold"
                               Foreground="#CDD6F4"
                               IsVisible="{Binding IsHotkeySupported}" />
                    <Grid ColumnDefinitions="70,*" RowDefinitions="Auto,Auto" Margin="0,0,0,0"
                          IsVisible="{Binding IsHotkeySupported}">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [Settings_HotkeyKey], Source={StaticResource Loc}}"
                                   VerticalAlignment="Center" Foreground="#A6ADC8" FontSize="12" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding HotkeyKey}"
                                 Watermark="{Binding [Settings_HotkeyKeyWatermark], Source={StaticResource Loc}}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [Settings_HotkeyModifiers], Source={StaticResource Loc}}"
                                   VerticalAlignment="Center" Foreground="#A6ADC8" FontSize="12"
                                   Margin="0,6,0,0" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"
                                    Spacing="10" Margin="0,6,0,0">
                            <CheckBox Content="Ctrl" IsChecked="{Binding HotkeyCtrl}" />
                            <CheckBox Content="Shift" IsChecked="{Binding HotkeyShift}" />
                            <CheckBox Content="Alt" IsChecked="{Binding HotkeyAlt}" />
                            <CheckBox Content="GUI" IsChecked="{Binding HotkeyGui}" />
                        </StackPanel>
                    </Grid>

                    <!-- Separator -->
                    <Border Height="1" Background="#313244" Margin="0,4" />

                    <!-- Layer Hold Threshold -->
                    <TextBlock Text="{Binding [Settings_LayerHoldThreshold], Source={StaticResource Loc}}" FontSize="14" FontWeight="SemiBold"
                               Foreground="#CDD6F4" />
                    <TextBlock Text="{Binding [Settings_LayerHoldThresholdHint], Source={StaticResource Loc}}"
                               Foreground="#6C7086" FontSize="11" TextWrapping="Wrap" Margin="0,-4,0,0" />
                    <TextBlock Text="{Binding DeviceTappingTermHint}"
                               Foreground="#A6E3A1" FontSize="11" Margin="0,-4,0,0" />
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ThresholdDisplay}"
                                   Foreground="#CDD6F4" FontWeight="SemiBold" Width="50"
                                   VerticalAlignment="Center" TextAlignment="Right" />
                        <Slider Minimum="0" Maximum="500"
                                Value="{Binding LayerHoldThresholdMs}"
                                TickFrequency="50" IsSnapToTickEnabled="True" />
                    </DockPanel>

                    <!-- Separator -->
                    <Border Height="1" Background="#313244" Margin="0,4" />

                    <!-- Custom Key Labels -->
                    <TextBlock Text="{Binding [Settings_CustomKeyLabels], Source={StaticResource Loc}}" FontSize="14" FontWeight="SemiBold"
                               Foreground="#CDD6F4" />
                    <TextBlock Text="{Binding [Settings_CustomKeyLabelsHint], Source={StaticResource Loc}}"
                               Foreground="#6C7086" FontSize="11" Margin="0,-4,0,0" />
                    <ItemsControl ItemsSource="{Binding CustomKeyLabels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CustomKeyLabelViewModel">
                                <Grid ColumnDefinitions="72,90,*,Auto" Margin="0,2">
                                    <TextBlock Grid.Column="0" Text="{Binding HexKeycode}"
                                               VerticalAlignment="Center" Foreground="#A6ADC8"
                                               FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="{Binding CurrentLabel}"
                                               VerticalAlignment="Center" Foreground="#6C7086"
                                               FontSize="12" Margin="4,0" />
                                    <TextBox Grid.Column="2" Text="{Binding UserLabel}"
                                             Watermark="{Binding [Settings_CustomLabelWatermark], Source={StaticResource Loc}}" Margin="4,0" />
                                    <Button Grid.Column="3" Content="x" Padding="6,2"
                                            Command="{Binding RemoveCommand}"
                                            ToolTip.Tip="{Binding [Tooltip_Remove], Source={StaticResource Loc}}"
                                            IsVisible="{Binding IsManualEntry}" FontSize="11" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Text="{Binding NewKeycodeHex}"
                                 Watermark="{Binding [Settings_HexKeycodeWatermark], Source={StaticResource Loc}}" />
                        <Button Grid.Column="1" Content="{Binding [Common_Add], Source={StaticResource Loc}}" Margin="6,0,0,0"
                                Command="{Binding AddCustomLabelCommand}" Padding="10,4" />
                    </Grid>

                </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>

</Window>
