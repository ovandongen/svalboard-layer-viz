<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SvalboardLayerViz.App.ViewModels"
        xmlns:conv="using:SvalboardLayerViz.App.Converters"
        x:Class="SvalboardLayerViz.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Width="620" Height="700"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <conv:HexColorToBrushConverter x:Key="HexToBrush" />
    </Window.Resources>

    <DockPanel Margin="12">
        <!-- Footer buttons — always visible -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" />
            <Button Content="Save" Command="{Binding SaveCommand}" />
        </StackPanel>

        <TabControl>

            <!-- ══════════════ Appearance Tab ══════════════ -->
            <TabItem Header="Appearance">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8,12" Spacing="12">

                    <!-- Layer Colors & Names -->
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="Layer Colors &amp; Names"
                                   FontSize="14" FontWeight="SemiBold" Foreground="#CDD6F4"
                                   VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Content="Reset Colors"
                                Command="{Binding ResetColorsCommand}"
                                HorizontalAlignment="Right" Padding="8,3" FontSize="12" />
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding LayerSettings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LayerSettingViewModel">
                                <Grid ColumnDefinitions="56,*,Auto" Margin="0,2">
                                    <TextBlock Grid.Column="0" Text="{Binding Index, StringFormat='Layer {0}'}"
                                               VerticalAlignment="Center" Foreground="#A6ADC8" FontSize="12" />
                                    <TextBox Grid.Column="1" Text="{Binding Name}"
                                             Watermark="Name (optional)" Margin="6,0"
                                             VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Padding="2"
                                            Background="Transparent" BorderThickness="0"
                                            VerticalAlignment="Center">
                                        <Border Width="28" Height="20" CornerRadius="3"
                                                Background="{Binding EffectiveColor, Converter={StaticResource HexToBrush}}"
                                                BorderBrush="#45475A" BorderThickness="1" />
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedRight">
                                                <ColorView Color="{Binding PickerColor}"
                                                           IsAlphaVisible="False" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Separator -->
                    <Border Height="1" Background="#313244" Margin="0,4" />

                    <!-- Background Fill -->
                    <TextBlock Text="Background Fill" FontSize="14" FontWeight="SemiBold"
                               Foreground="#CDD6F4" />
                    <TextBlock Text="0% = transparent overlay, 100% = solid dark"
                               Foreground="#6C7086" FontSize="11" Margin="0,-4,0,0" />
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding OpacityPercent}"
                                   Foreground="#CDD6F4" FontWeight="SemiBold" Width="40"
                                   VerticalAlignment="Center" TextAlignment="Right" />
                        <Slider Minimum="0" Maximum="1.0"
                                Value="{Binding BackgroundOpacity}"
                                TickFrequency="0.05" IsSnapToTickEnabled="True" />
                    </DockPanel>

                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════════ Behavior Tab ══════════════ -->
            <TabItem Header="Behavior">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8,12" Spacing="12">

                    <!-- Global Hotkey (not supported on Linux/Wayland) -->
                    <TextBlock Text="Global Hotkey" FontSize="14" FontWeight="SemiBold"
                               Foreground="#CDD6F4"
                               IsVisible="{Binding IsHotkeySupported}" />
                    <Grid ColumnDefinitions="70,*" RowDefinitions="Auto,Auto" Margin="0,0,0,0"
                          IsVisible="{Binding IsHotkeySupported}">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Key:"
                                   VerticalAlignment="Center" Foreground="#A6ADC8" FontSize="12" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding HotkeyKey}"
                                 Watermark="e.g. F12" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Modifiers:"
                                   VerticalAlignment="Center" Foreground="#A6ADC8" FontSize="12"
                                   Margin="0,6,0,0" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"
                                    Spacing="10" Margin="0,6,0,0">
                            <CheckBox Content="Ctrl" IsChecked="{Binding HotkeyCtrl}" />
                            <CheckBox Content="Shift" IsChecked="{Binding HotkeyShift}" />
                            <CheckBox Content="Alt" IsChecked="{Binding HotkeyAlt}" />
                            <CheckBox Content="GUI" IsChecked="{Binding HotkeyGui}" />
                        </StackPanel>
                    </Grid>

                    <!-- Separator -->
                    <Border Height="1" Background="#313244" Margin="0,4" />

                    <!-- Layer Hold Threshold -->
                    <TextBlock Text="Layer Hold Threshold" FontSize="14" FontWeight="SemiBold"
                               Foreground="#CDD6F4" />
                    <TextBlock Text="Min hold time before MO/LT keys switch the displayed layer. Prevents flicker from quick taps."
                               Foreground="#6C7086" FontSize="11" TextWrapping="Wrap" Margin="0,-4,0,0" />
                    <TextBlock Text="{Binding DeviceTappingTermHint}"
                               Foreground="#A6E3A1" FontSize="11" Margin="0,-4,0,0" />
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ThresholdDisplay}"
                                   Foreground="#CDD6F4" FontWeight="SemiBold" Width="50"
                                   VerticalAlignment="Center" TextAlignment="Right" />
                        <Slider Minimum="0" Maximum="500"
                                Value="{Binding LayerHoldThresholdMs}"
                                TickFrequency="50" IsSnapToTickEnabled="True" />
                    </DockPanel>

                    <!-- Separator -->
                    <Border Height="1" Background="#313244" Margin="0,4" />

                    <!-- Custom Key Labels -->
                    <TextBlock Text="Custom Key Labels" FontSize="14" FontWeight="SemiBold"
                               Foreground="#CDD6F4" />
                    <TextBlock Text="Assign labels to unknown keycodes from your board"
                               Foreground="#6C7086" FontSize="11" Margin="0,-4,0,0" />
                    <ItemsControl ItemsSource="{Binding CustomKeyLabels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CustomKeyLabelViewModel">
                                <Grid ColumnDefinitions="72,90,*,Auto" Margin="0,2">
                                    <TextBlock Grid.Column="0" Text="{Binding HexKeycode}"
                                               VerticalAlignment="Center" Foreground="#A6ADC8"
                                               FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="{Binding CurrentLabel}"
                                               VerticalAlignment="Center" Foreground="#6C7086"
                                               FontSize="12" Margin="4,0" />
                                    <TextBox Grid.Column="2" Text="{Binding UserLabel}"
                                             Watermark="Custom label" Margin="4,0" />
                                    <Button Grid.Column="3" Content="x" Padding="6,2"
                                            Command="{Binding RemoveCommand}"
                                            ToolTip.Tip="Remove"
                                            IsVisible="{Binding IsManualEntry}" FontSize="11" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Text="{Binding NewKeycodeHex}"
                                 Watermark="Hex keycode (e.g. 0x5300)" />
                        <Button Grid.Column="1" Content="Add" Margin="6,0,0,0"
                                Command="{Binding AddCustomLabelCommand}" Padding="10,4" />
                    </Grid>

                </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>

</Window>
