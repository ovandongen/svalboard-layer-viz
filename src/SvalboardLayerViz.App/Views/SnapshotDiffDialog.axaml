<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SvalboardLayerViz.App.ViewModels"
        xmlns:conv="using:SvalboardLayerViz.App.Converters"
        x:Class="SvalboardLayerViz.App.Views.SnapshotDiffDialog"
        x:DataType="vm:SnapshotDiffDialogViewModel"
        Title="{Binding Title}"
        Width="900" Height="650"
        MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="#1E1E2E">

    <DockPanel Margin="16">

        <!-- Title -->
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding Title}"
                   FontSize="16" FontWeight="SemiBold"
                   Foreground="#CDD6F4"
                   Margin="0,0,0,8" />

        <!-- Warning banner -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding HasWarning}"
                Background="#F9E2AF"
                CornerRadius="6"
                Padding="12,8"
                Margin="0,0,0,8">
            <TextBlock Text="{Binding WarningBanner}"
                       Foreground="#1E1E2E"
                       TextWrapping="Wrap"
                       FontSize="12" />
        </Border>

        <!-- No changes message -->
        <TextBlock DockPanel.Dock="Top"
                   IsVisible="{Binding !HasChanges}"
                   Text="{Binding [Diff_NoChanges], Source={StaticResource Loc}}"
                   Foreground="#A6ADC8"
                   FontSize="14"
                   HorizontalAlignment="Center"
                   Margin="0,8,0,8" />

        <!-- Button bar -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8">
                <Button Content="{Binding [History_ExportRow], Source={StaticResource Loc}}"
                        Command="{Binding ExportCommand}"
                        Padding="12,6" />
                <Button Content="{Binding [History_DeleteRow], Source={StaticResource Loc}}"
                        Command="{Binding DeleteCommand}"
                        Padding="12,6" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right">
                <Button Content="{Binding [Common_Cancel], Source={StaticResource Loc}}"
                        Command="{Binding CancelCommand}"
                        Padding="12,6" />
                <!-- Panel wrapper ensures tooltip shows even when button is disabled -->
                <Panel ToolTip.Tip="{Binding RestoreDisabledReason}">
                    <Button Content="{Binding [History_RestoreRow], Source={StaticResource Loc}}"
                            Command="{Binding RestoreCommand}"
                            IsEnabled="{Binding CanRestore}"
                            Padding="16,6"
                            Background="#89B4FA"
                            Foreground="#1E1E2E"
                            FontWeight="SemiBold" />
                </Panel>
            </StackPanel>
        </DockPanel>

        <!-- Change list -->
        <Border DockPanel.Dock="Bottom"
                IsVisible="{Binding HasChanges}"
                Background="#181825"
                CornerRadius="6"
                Padding="8"
                Margin="0,8,0,0"
                MaxHeight="150">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Foreground="#A6ADC8"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4">
                    <TextBlock.Text>
                        <Binding Path="ChangeCount"
                                 StringFormat="Changes ({0}):" />
                    </TextBlock.Text>
                </TextBlock>
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding ChangeLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DiffLineViewModel">
                                <TextBlock Text="{Binding FormattedText}"
                                           Foreground="#CDD6F4"
                                           FontSize="11"
                                           FontFamily="Cascadia Mono,Consolas,monospace"
                                           Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Side-by-side mini-boards -->
        <Grid ColumnDefinitions="*,Auto,*" Margin="0,8,0,0">

            <!-- Snapshot side -->
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8"
                            Margin="0,0,0,8">
                    <TextBlock Text="{Binding [Diff_SnapshotSide], Source={StaticResource Loc}}"
                               Foreground="#A6ADC8"
                               FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <NumericUpDown Value="{Binding SnapshotSelectedLayerIndex}"
                                   Minimum="0"
                                   Maximum="{Binding MaxLayerIndex}"
                                   Increment="1"
                                   FormatString="'L'0"
                                   Width="100"
                                   Height="26"
                                   Padding="4,2"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   VerticalContentAlignment="Center" />
                </StackPanel>
                <Border Background="#181825" CornerRadius="8" Padding="8">
                    <Viewbox Stretch="Uniform" StretchDirection="Both">
                        <ItemsControl ItemsSource="{Binding SnapshotKeys}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas Width="440" Height="140" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.Styles>
                                <Style Selector="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                </Style>
                            </ItemsControl.Styles>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DiffMiniKeyDisplay">
                                    <Border Width="{Binding W}" Height="{Binding H}"
                                            CornerRadius="2"
                                            Background="{Binding Background, Converter={x:Static conv:HexColorToBrushConverter.Instance}}"
                                            BorderBrush="{Binding BorderBrush, Converter={x:Static conv:HexColorToBrushConverter.Instance}}"
                                            BorderThickness="{Binding BorderThickness}"
                                            ToolTip.Tip="{Binding Label}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Viewbox>
                </Border>
            </DockPanel>

            <!-- Sync toggle -->
            <StackPanel Grid.Column="1" VerticalAlignment="Top"
                        Margin="8,0,8,0">
                <ToggleButton IsChecked="{Binding SyncLayers}"
                              Content="{Binding [Diff_SyncLayers], Source={StaticResource Loc}}"
                              FontSize="10"
                              Padding="6,4"
                              Margin="0,28,0,0" />
            </StackPanel>

            <!-- Device side -->
            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8"
                            Margin="0,0,0,8">
                    <TextBlock Text="{Binding [Diff_DeviceSide], Source={StaticResource Loc}}"
                               Foreground="#A6ADC8"
                               FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <NumericUpDown Value="{Binding DeviceSelectedLayerIndex}"
                                   Minimum="0"
                                   Maximum="{Binding MaxLayerIndex}"
                                   Increment="1"
                                   FormatString="'L'0"
                                   Width="100"
                                   Height="26"
                                   Padding="4,2"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   VerticalContentAlignment="Center" />
                </StackPanel>
                <Border Background="#181825" CornerRadius="8" Padding="8">
                    <Viewbox Stretch="Uniform" StretchDirection="Both">
                        <ItemsControl ItemsSource="{Binding DeviceKeys}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas Width="440" Height="140" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.Styles>
                                <Style Selector="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                </Style>
                            </ItemsControl.Styles>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DiffMiniKeyDisplay">
                                    <Border Width="{Binding W}" Height="{Binding H}"
                                            CornerRadius="2"
                                            Background="{Binding Background, Converter={x:Static conv:HexColorToBrushConverter.Instance}}"
                                            BorderBrush="{Binding BorderBrush, Converter={x:Static conv:HexColorToBrushConverter.Instance}}"
                                            BorderThickness="{Binding BorderThickness}"
                                            ToolTip.Tip="{Binding Label}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Viewbox>
                </Border>
            </DockPanel>

        </Grid>

    </DockPanel>

</Window>
