<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SvalboardLayerViz.App.ViewModels"
             xmlns:views="using:SvalboardLayerViz.App.Views"
             x:Class="SvalboardLayerViz.App.Views.ThumbClusterView"
             x:DataType="vm:KeyClusterViewModel"
             Width="{Binding Width}"
             Height="{Binding Height}">

    <UserControl.Resources>
        <!-- Shared label content for creative thumb keys -->
        <DataTemplate x:Key="ThumbKeyContent" x:DataType="vm:KeyViewModel">
            <Grid>
                <ToolTip.Tip>
                    <TextBlock Text="{Binding Tooltip}" />
                </ToolTip.Tip>
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{Binding [Key_SetCustomLabel], Source={StaticResource Loc}}"
                                  Command="{Binding SetLabelCommand}" />
                    </ContextMenu>
                </Grid.ContextMenu>

                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="0">
                    <TextBlock Text="{Binding SecondaryLabel}"
                               FontSize="26" FontWeight="SemiBold"
                               Foreground="{Binding TextColor}" Opacity="0.8"
                               HorizontalAlignment="Center"
                               IsVisible="{Binding SecondaryLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="6" Opacity="0.4" OffsetX="0" OffsetY="0" />
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="{Binding DisplayLabel}"
                               FontSize="36" FontWeight="ExtraBold"
                               Foreground="{Binding TextColor}"
                               TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="6" Opacity="0.4" OffsetX="0" OffsetY="0" />
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>

                <TextBlock Text="{Binding ShiftedLabel}"
                           FontSize="28" FontWeight="SemiBold"
                           Foreground="{Binding TextColor}" Opacity="0.7"
                           HorizontalAlignment="Right" VerticalAlignment="Top"
                           Margin="0,4,12,0"
                           IsVisible="{Binding ShiftedLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="6" Opacity="0.4" OffsetX="0" OffsetY="0" />
                    </TextBlock.Effect>
                </TextBlock>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- ═══ Default layout (original ItemsControl with KeyView) ═══ -->
        <ItemsControl x:Name="DefaultLayout" ItemsSource="{Binding Keys}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerTheme>
                <ControlTheme TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding Left}" />
                    <Setter Property="Canvas.Top" Value="{Binding Top}" />
                </ControlTheme>
            </ItemsControl.ItemContainerTheme>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:KeyViewModel">
                    <views:KeyView />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ═══ Left thumb creative layout ═══ -->
        <Viewbox x:Name="LeftCreativeLayout" Stretch="Uniform" IsVisible="False">
            <Canvas Width="880" Height="435">
                <Border DataContext="{Binding Keys[2]}" ZIndex="0"
                        Canvas.Left="338" Canvas.Top="5" Width="199" Height="430"
                        CornerRadius="16" Padding="0,240,0,0"
                        Background="{Binding BackgroundColor}"
                        BorderBrush="{Binding BorderColor}"
                        BorderThickness="{Binding ActiveBorderThickness}"
                        Opacity="{Binding KeyOpacity}">
                    <Border.Clip>
                        <GeometryGroup FillRule="EvenOdd">
                            <!-- Trapezoid: wider at bottom, rounded corners R=16 -->
                            <PathGeometry Figures="M 12,16 A 16,16 0 0 1 28,0 L 171,0 A 16,16 0 0 1 187,16 L 199,414 A 16,16 0 0 1 183,430 L 16,430 A 16,16 0 0 1 0,414 Z" />
                            <!-- C:4 bite: reaches C:2's angled left edge -->
                            <PathGeometry Figures="M 7,190 L 48,190 A 24,24 0 0 1 72,214 L 72,286 A 24,24 0 0 1 48,310 L 3,310 Z" />
                            <!-- C:5 hole (+12px offset for wider border) -->
                            <PathGeometry Figures="M 46,15 L 153,15 A 24,24 0 0 1 177,39 L 177,151 A 24,24 0 0 1 153,175 L 46,175 A 24,24 0 0 1 22,151 L 22,39 A 24,24 0 0 1 46,15 Z" />
                        </GeometryGroup>
                    </Border.Clip>
                    <ContentPresenter ContentTemplate="{StaticResource ThumbKeyContent}" Content="{Binding}" />
                </Border>
                <Border DataContext="{Binding Keys[5]}" ZIndex="2"
                        Canvas.Left="370" Canvas.Top="30" Width="135" Height="140"
                        CornerRadius="14"
                        Background="{Binding BackgroundColor}"
                        BorderBrush="{Binding BorderColor}"
                        BorderThickness="{Binding ActiveBorderThickness}"
                        Opacity="{Binding KeyOpacity}">
                    <ContentPresenter ContentTemplate="{StaticResource ThumbKeyContent}" Content="{Binding}" />
                </Border>
                <Border DataContext="{Binding Keys[3]}" ZIndex="1"
                        Canvas.Left="30" Canvas.Top="30" Width="280" Height="140"
                        CornerRadius="14"
                        Background="{Binding BackgroundColor}"
                        BorderBrush="{Binding BorderColor}"
                        BorderThickness="{Binding ActiveBorderThickness}"
                        Opacity="{Binding KeyOpacity}">
                    <Border.Clip>
                        <!-- Right (inner) edge narrows at bottom, rounded corners R=14 -->
                        <PathGeometry Figures="M 0,14 A 14,14 0 0 1 14,0 L 266,0 A 14,14 0 0 1 280,14 L 276,126 A 14,14 0 0 1 262,140 L 14,140 A 14,14 0 0 1 0,126 Z" />
                    </Border.Clip>
                    <ContentPresenter ContentTemplate="{StaticResource ThumbKeyContent}" Content="{Binding}" />
                </Border>
                <Border DataContext="{Binding Keys[1]}" ZIndex="1"
                        Canvas.Left="565" Canvas.Top="30" Width="285" Height="140"
                        CornerRadius="14"
                        Background="{Binding BackgroundColor}"
                        BorderBrush="{Binding BorderColor}"
                        BorderThickness="{Binding ActiveBorderThickness}"
                        Opacity="{Binding KeyOpacity}">
                    <Border.Clip>
                        <!-- Left edge continues C:0's line, rounded corners R=14 -->
                        <PathGeometry Figures="M 0,14 A 14,14 0 0 1 14,0 L 271,0 A 14,14 0 0 1 285,14 L 285,126 A 14,14 0 0 1 271,140 L 18,140 A 14,14 0 0 1 4,126 Z" />
                    </Border.Clip>
                    <ContentPresenter ContentTemplate="{StaticResource ThumbKeyContent}" Content="{Binding}" />
                </Border>
                <Border DataContext="{Binding Keys[4]}" ZIndex="1"
                        Canvas.Left="30" Canvas.Top="205" Width="370" Height="100"
                        CornerRadius="14"
                        Background="{Binding BackgroundColor}"
                        BorderBrush="{Binding BorderColor}"
                        BorderThickness="{Binding ActiveBorderThickness}"
                        Opacity="{Binding KeyOpacity}">
                    <ContentPresenter ContentTemplate="{StaticResource ThumbKeyContent}" Content="{Binding}" />
                </Border>
                <Border DataContext="{Binding Keys[0]}" ZIndex="1"
                        Canvas.Left="570" Canvas.Top="205" Width="280" Height="140"
                        CornerRadius="14"
                        Background="{Binding BackgroundColor}"
                        BorderBrush="{Binding BorderColor}"
                        BorderThickness="{Binding ActiveBorderThickness}"
                        Opacity="{Binding KeyOpacity}">
                    <Border.Clip>
                        <!-- Left (inner) edge narrows at bottom, rounded corners R=14 -->
                        <PathGeometry Figures="M 0,14 A 14,14 0 0 1 14,0 L 266,0 A 14,14 0 0 1 280,14 L 280,126 A 14,14 0 0 1 266,140 L 18,140 A 14,14 0 0 1 4,126 Z" />
                    </Border.Clip>
                    <ContentPresenter ContentTemplate="{StaticResource ThumbKeyContent}" Content="{Binding}" />
                </Border>
            </Canvas>
        </Viewbox>

        <!-- ═══ Right thumb creative layout (horizontally mirrored) ═══ -->
        <Viewbox x:Name="RightCreativeLayout" Stretch="Uniform" IsVisible="False">
            <Canvas Width="880" Height="435">
                <Border DataContext="{Binding Keys[2]}" ZIndex="0"
                        Canvas.Left="343" Canvas.Top="5" Width="199" Height="430"
                        CornerRadius="16" Padding="0,240,0,0"
                        Background="{Binding BackgroundColor}"
                        BorderBrush="{Binding BorderColor}"
                        BorderThickness="{Binding ActiveBorderThickness}"
                        Opacity="{Binding KeyOpacity}">
                    <Border.Clip>
                        <GeometryGroup FillRule="EvenOdd">
                            <!-- Trapezoid: wider at bottom, rounded corners R=16 -->
                            <PathGeometry Figures="M 12,16 A 16,16 0 0 1 28,0 L 171,0 A 16,16 0 0 1 187,16 L 199,414 A 16,16 0 0 1 183,430 L 16,430 A 16,16 0 0 1 0,414 Z" />
                            <!-- C:4 bite: reaches C:2's angled right edge -->
                            <PathGeometry Figures="M 192,190 L 151,190 A 24,24 0 0 0 127,214 L 127,286 A 24,24 0 0 0 151,310 L 196,310 Z" />
                            <!-- C:5 hole (+12px offset for wider border) -->
                            <PathGeometry Figures="M 46,15 L 153,15 A 24,24 0 0 1 177,39 L 177,151 A 24,24 0 0 1 153,175 L 46,175 A 24,24 0 0 1 22,151 L 22,39 A 24,24 0 0 1 46,15 Z" />
                        </GeometryGroup>
                    </Border.Clip>
                    <ContentPresenter ContentTemplate="{StaticResource ThumbKeyContent}" Content="{Binding}" />
                </Border>
                <Border DataContext="{Binding Keys[5]}" ZIndex="2"
                        Canvas.Left="375" Canvas.Top="30" Width="135" Height="140"
                        CornerRadius="14"
                        Background="{Binding BackgroundColor}"
                        BorderBrush="{Binding BorderColor}"
                        BorderThickness="{Binding ActiveBorderThickness}"
                        Opacity="{Binding KeyOpacity}">
                    <ContentPresenter ContentTemplate="{StaticResource ThumbKeyContent}" Content="{Binding}" />
                </Border>
                <Border DataContext="{Binding Keys[3]}" ZIndex="1"
                        Canvas.Left="570" Canvas.Top="30" Width="280" Height="140"
                        CornerRadius="14"
                        Background="{Binding BackgroundColor}"
                        BorderBrush="{Binding BorderColor}"
                        BorderThickness="{Binding ActiveBorderThickness}"
                        Opacity="{Binding KeyOpacity}">
                    <Border.Clip>
                        <!-- Left (inner) edge narrows at bottom, rounded corners R=14 -->
                        <PathGeometry Figures="M 0,14 A 14,14 0 0 1 14,0 L 266,0 A 14,14 0 0 1 280,14 L 280,126 A 14,14 0 0 1 266,140 L 18,140 A 14,14 0 0 1 4,126 Z" />
                    </Border.Clip>
                    <ContentPresenter ContentTemplate="{StaticResource ThumbKeyContent}" Content="{Binding}" />
                </Border>
                <Border DataContext="{Binding Keys[1]}" ZIndex="1"
                        Canvas.Left="30" Canvas.Top="30" Width="285" Height="140"
                        CornerRadius="14"
                        Background="{Binding BackgroundColor}"
                        BorderBrush="{Binding BorderColor}"
                        BorderThickness="{Binding ActiveBorderThickness}"
                        Opacity="{Binding KeyOpacity}">
                    <Border.Clip>
                        <!-- Right edge continues C:0's line, rounded corners R=14 -->
                        <PathGeometry Figures="M 0,14 A 14,14 0 0 1 14,0 L 271,0 A 14,14 0 0 1 285,14 L 281,126 A 14,14 0 0 1 267,140 L 14,140 A 14,14 0 0 1 0,126 Z" />
                    </Border.Clip>
                    <ContentPresenter ContentTemplate="{StaticResource ThumbKeyContent}" Content="{Binding}" />
                </Border>
                <Border DataContext="{Binding Keys[4]}" ZIndex="1"
                        Canvas.Left="480" Canvas.Top="205" Width="370" Height="100"
                        CornerRadius="14"
                        Background="{Binding BackgroundColor}"
                        BorderBrush="{Binding BorderColor}"
                        BorderThickness="{Binding ActiveBorderThickness}"
                        Opacity="{Binding KeyOpacity}">
                    <ContentPresenter ContentTemplate="{StaticResource ThumbKeyContent}" Content="{Binding}" />
                </Border>
                <Border DataContext="{Binding Keys[0]}" ZIndex="1"
                        Canvas.Left="30" Canvas.Top="205" Width="280" Height="140"
                        CornerRadius="14"
                        Background="{Binding BackgroundColor}"
                        BorderBrush="{Binding BorderColor}"
                        BorderThickness="{Binding ActiveBorderThickness}"
                        Opacity="{Binding KeyOpacity}">
                    <Border.Clip>
                        <!-- Right (inner) edge narrows at bottom, rounded corners R=14 -->
                        <PathGeometry Figures="M 0,14 A 14,14 0 0 1 14,0 L 266,0 A 14,14 0 0 1 280,14 L 276,126 A 14,14 0 0 1 262,140 L 14,140 A 14,14 0 0 1 0,126 Z" />
                    </Border.Clip>
                    <ContentPresenter ContentTemplate="{StaticResource ThumbKeyContent}" Content="{Binding}" />
                </Border>
            </Canvas>
        </Viewbox>
    </Grid>

</UserControl>
