<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SvalboardLayerViz.App.ViewModels"
             x:Class="SvalboardLayerViz.App.Views.ThumbKeyView"
             x:DataType="vm:KeyViewModel"
             Background="Transparent">

    <ToolTip.Tip>
        <TextBlock Text="{Binding Tooltip}" />
    </ToolTip.Tip>

    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem Header="{Binding [Key_EditKeycode], Source={StaticResource Loc}}"
                      Command="{Binding ClickCommand}"
                      IsVisible="{Binding IsEditMode}" />
            <MenuItem Header="{Binding [Key_SetCustomLabel], Source={StaticResource Loc}}"
                      Command="{Binding SetLabelCommand}"
                      IsVisible="{Binding !IsEditMode}" />
        </ContextMenu>
    </UserControl.ContextMenu>

    <Grid Background="Transparent">
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="0">
            <TextBlock Text="{Binding SecondaryLabel}"
                       FontSize="26" FontWeight="SemiBold"
                       Foreground="{Binding TextColor}" Opacity="0.8"
                       HorizontalAlignment="Center"
                       IsVisible="{Binding SecondaryLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="6" Opacity="0.4" OffsetX="0" OffsetY="0" />
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="{Binding DisplayLabel}"
                       FontSize="36" FontWeight="ExtraBold"
                       Foreground="{Binding TextColor}"
                       TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="6" Opacity="0.4" OffsetX="0" OffsetY="0" />
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>

        <TextBlock Text="{Binding ShiftedLabel}"
                   FontSize="28" FontWeight="SemiBold"
                   Foreground="{Binding TextColor}" Opacity="0.7"
                   HorizontalAlignment="Right" VerticalAlignment="Top"
                   Margin="0,4,12,0"
                   IsVisible="{Binding ShiftedLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock.Effect>
                <DropShadowEffect Color="Black" BlurRadius="6" Opacity="0.4" OffsetX="0" OffsetY="0" />
            </TextBlock.Effect>
        </TextBlock>
    </Grid>

</UserControl>
